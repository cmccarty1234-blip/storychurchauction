# NOTE: variables are prefixed AUCTION_ on purpose so they can never collide with a DATABASE_URL
# already set in your shell for another project.
# Copy to .env.local for development.
# Local PostgreSQL (see README: `npm run db:init` then `npm run db:start`)
AUCTION_DATABASE_URL=postgres://postgres@127.0.0.1:54329/storychurch
# Test database used by `npm test`
AUCTION_TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/storychurch_test

# Public URL used inside QR codes. Use your laptop's LAN address for a phone test,
# e.g. http://192.168.1.20:3000. Change to the Vercel URL later — no code change needed.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Folder for uploaded item photos (local disk). Production needs object storage — see README.
UPLOAD_DIR=./uploads

# Where Postgres binaries live on Windows (for `npm run db:*`). Not needed on Supabase/Vercel.
PG_BIN=C:\pgsql-client\bin
